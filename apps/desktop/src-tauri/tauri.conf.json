{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoNeedWork",
  "version": "0.0.0",
  "identifier": "dev.noneedwork.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:*; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "title": "NoNeedWork",
        "width": 1280,
        "height": 800,
        "minWidth": 1040,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/nw-runtime"],
    "resources": {
      "binaries/nw-runtime-resources/": "nw-runtime-resources/"
    }
  }
}
